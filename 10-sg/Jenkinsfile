pipeline {
    agent {
        node {
            label 'AGENT-1'
        }
    }

    environment {
        COURSE = "jenkins" // access to all stages
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        ansiColor('xterm')
    }

    stages {
        stage('init') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'us-east-1') {
                    sh '''
                        cd 10-sg
                        terraform init
                    '''
                }
            }
        }
        stage('plan') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'us-east-1') {
                    sh '''
                        cd 10-sg
                        terraform plan
                    '''
                }
            }
        }
        stage('Deploy') {
            steps {
                withAWS(credentials: 'aws-creds', region: 'us-east-1') {
                    sh '''
                        cd 10-sg
                        terraform apply -auto-approve
                    '''
                }
            }
        }
        stage('parallel jobs') {
            parallel {
                stage('sg rules') {
                    steps {
                        script {
                            build job: '30-sg-rules',
                                wait: false,
                                propagate: false
                        }
                    }
                }
                stage('bastion') {
                    steps {
                        script {
                            build job: '20-bastion',
                                wait: false,
                                propagate: false
                        }
                    }
                }
                stage('ACM') {
                    steps {
                        script {
                            build job: '70-acm',
                                wait: true,
                                propagate: false
                        }
                    }
                }
                stage('ECR') {
                    steps {
                        script {
                            build job: '40-ecr',
                                wait: false,
                                propagate: false
                        }
                    }
                }
                 stage('EKS') {                
                    steps {
                        script {
                            build job: '100-eks',
                                wait: false,
                                propagate: false
                        }
                    }
                }
                stage('ingress-lb') {                    
                    steps {
                        script {
                            build job: '80-ingress-alb',
                                wait: false,
                                propagate: false
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'I will always say Hello'
            cleanWs()
        }

        success {
            echo 'Run if pipeline success'
        }

        failure {
            echo 'Run if pipeline failure'
        }

        aborted {
            echo 'pipeline is aborted'
        }
    }
}
